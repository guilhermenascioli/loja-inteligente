# A aplicação lê variáveis de ambiente; NÃO lê arquivos .env automaticamente.
# Não coloque uma chave real neste arquivo público.
# Gemini: projeto próprio no nível gratuito, SEM faturamento vinculado.
LOJA_GEMINI_API_KEY=
LOJA_GEMINI_MODEL=
# Preencha com sim somente após conferir o nível gratuito no Google AI Studio.
LOJA_GEMINI_FREE_TIER_CONFIRMED=
# Alternativa sem API externa: modelo já instalado localmente no Ollama.
LOJA_OLLAMA_MODEL=
